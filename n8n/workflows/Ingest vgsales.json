    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\n\nconst toNull = v => (v === undefined || v === null || String(v).trim() === '' || String(v).trim() === 'N/A') ? null : String(v).trim();\n\nconst cleaned = rows.map(r => ({\n  rank: parseInt(r.Rank, 10),\n  name: toNull(r.Name),\n  platform: toNull(r.Platform),\n  year: toNull(r.Year) === null ? null : parseInt(r.Year, 10),\n  genre: toNull(r.Genre),\n  publisher: toNull(r.Publisher),\n  na_sales: parseFloat(r.NA_Sales),\n  eu_sales: parseFloat(r.EU_Sales),\n  jp_sales: parseFloat(r.JP_Sales),\n  other_sales: parseFloat(r.Other_Sales),\n  global_sales: parseFloat(r.Global_Sales),\n}));\n\n// Fail loudly on bad rows instead of loading them\nconst bad = cleaned.filter(r =>\n  !r.name || !r.platform || !r.genre ||\n  [r.na_sales, r.eu_sales, r.jp_sales, r.other_sales, r.global_sales].some(Number.isNaN)\n);\nif (bad.length > 0) {\n  throw new Error(`${bad.length} bad rows, first: ${JSON.stringify(bad[0])}`);\n}\n\nreturn cleaned.map(r => ({ json: r }));\n\n"
      },
